# Supabase — must be the SAME project the Neo desktop app uses so that accounts,
# plans and payments are shared between the site and the app.
# Copy this file to `.env` (git-ignored) and fill in your project values.
# Dashboard → Project Settings → API. The site runs signed-out when empty.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: override where Supabase sends the browser back to after GitHub/Google
# OAuth or email confirmation. Defaults to the current origin + base path.
# Must match Supabase Dashboard → Auth → URL Configuration → Redirect URLs,
# e.g. https://lumorix-studios.github.io/LumorixStudiosHq/* and
#      http://localhost:5173/LumorixStudiosHq/*
VITE_OAUTH_REDIRECT_URL=
